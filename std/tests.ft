// What the standard library is meant to do, asserted rather than assumed.
//
//     fortec std/tests.ft --test -o t && ./t
//
// **Why one file rather than a `%test` at the foot of each module.** A test
// needs `test` and `fmt`, and a module that imports one imports it for every
// program that imports the module: `roots` compiles every non-generic fn there
// is, so a `%test` written inside `vec.ft` would put the whole of `fmt` into
// every program that used a vector. The tests themselves are left out of an
// ordinary build and their imports are not. So they live here, where nothing
// but a test build reads them.
//
// Every module is reached by its name -- `vec::len`, `treemap::len` -- because
// four of them declare a `len` and importing the four would be importing one
// name four times. One leaf of each is imported to make the module read, and
// what that leaf is does not matter.
//
// The `i64` comparisons come from `order`, which is where the operations a
// container is handed live and why they are values rather than methods.

import test::{assert, assert_eq};
import vec::Vec;
import option::Option;
import panic::panic;
import result::Result;
import range::Range;
import hashmap::HashMap;
import hashset::HashSet;
import treemap::TreeMap;
import treeset::TreeSet;

// ---- Vec ---------------------------------------------------------------------

%test
fn a_vector_starts_with_nothing_in_it() {
    var v: Vec<i64> = vec::empty()
    assert_eq(&vec::len(&v), &0, "a new vector is empty")
    assert(vec::is_empty(&v), "and says so")
}

%test
fn a_vector_gives_back_what_was_put_in_it() {
    var v: Vec<i64> = vec::empty()
    vec::push(*v, 10)
    vec::push(*v, 20)
    vec::push(*v, 30)
    assert_eq(&vec::len(&v), &3, "three were pushed")
    if vec::len(&v) != 3 { return }
    assert_eq(&vec::at(&v, 0), &10, "the first")
    assert_eq(&vec::at(&v, 1), &20, "the second")
    assert_eq(&vec::at(&v, 2), &30, "the third")
}

// The doubling is what makes a run of pushes cost a constant each, and what it
// must not cost is an element: everything already in has to survive the move.
%test
fn everything_survives_a_vector_growing_many_times() {
    var v: Vec<i64> = vec::empty()
    for i in 0..200 {
        vec::push(*v, i * 3)
    }
    assert_eq(&vec::len(&v), &200, "two hundred were pushed")
    if vec::len(&v) != 200 { return }
    var wrong = 0
    for i in 0..200 {
        if vec::at(&v, i) != i * 3 {
            wrong = wrong + 1
        }
    }
    assert_eq(&wrong, &0, "every one of them is still what it was")
}

// `pop` takes the last one and shortens the vector, which is the half a caller
// cannot see from the value it gets back.
%test
fn popping_takes_the_last_one_and_shortens_the_vector() {
    var v: Vec<i64> = vec::empty()
    vec::push(*v, 1)
    vec::push(*v, 2)
    assert_eq(&vec::pop(*v), &2, "the last one comes back")
    assert_eq(&vec::len(&v), &1, "and is gone")
    assert_eq(&vec::pop(*v), &1, "then the one before it")
    assert(vec::is_empty(&v), "and the vector is empty again")
}

// Every index the vector has is still readable: the check added for the ones it
// does not have must not turn down the ones it does, and off by one at either
// end is how that goes wrong.
%test
fn every_index_a_vector_has_is_still_readable() {
    var v: Vec<i64> = vec::empty()
    for i in 0..8 {
        vec::push(*v, i)
    }
    var seen = 0
    for i in 0..8 {
        if vec::at(&v, i) == i {
            seen = seen + 1
        }
    }
    assert_eq(&seen, &8, "the first and the last among them")
}

%test
fn a_place_written_reads_back_as_what_was_written() {
    var v: Vec<i64> = vec::empty()
    vec::push(*v, 1)
    vec::put(&v, 0, 99)
    assert_eq(&vec::at(&v, 0), &99, "the place was written")
    assert_eq(&vec::len(&v), &1, "and writing one is not adding one")
}

// ---- Option --------------------------------------------------------------------

// A fresh one for each call: an `Option` is not `Copy`, so handing one over
// hands it away, and a test that asked two questions of one value would be
// asking the second of a name that had been moved out of.
%test
fn an_option_knows_which_of_the_two_it_is() {
    let some: Option<i64> = Option::Some(7)
    assert(option::is_some(some), "Some is some")
    let also_some: Option<i64> = Option::Some(7)
    assert(!option::is_none(also_some), "and is not none")

    let none: Option<i64> = Option::None
    assert(option::is_none(none), "None is none")
    let also_none: Option<i64> = Option::None
    assert(!option::is_some(also_none), "and is not some")
}

// There is no routine that takes the value out without being told what to do
// when there is none, so this is the only way out of one.
%test
fn unwrapping_gives_the_value_or_what_was_offered_instead() {
    let some: Option<i64> = Option::Some(7)
    assert_eq(&option::unwrap_or(some, 0), &7, "Some gives what is in it")
    let none: Option<i64> = Option::None
    assert_eq(&option::unwrap_or(none, 0), &0, "None gives the fallback")
}

// The path that does not stop. What `unwrap` does when there is nothing to
// unwrap cannot be asked here -- it ends the process, and a test that ended the
// process would take every test after it -- so that half is asked by running a
// program, in `src/tests.rs`.
%test
fn unwrapping_a_some_gives_what_is_in_it() {
    let some: Option<i64> = Option::Some(7)
    assert_eq(&option::unwrap(some, "there is one"), &7, "Some unwraps")
}

// ---- Result ---------------------------------------------------------------------

%test
fn a_result_knows_which_of_the_two_it_is() {
    let ok: Result<i64, i64> = Result::Ok(1)
    assert(result::is_ok(ok), "Ok is ok")
    let also_ok: Result<i64, i64> = Result::Ok(1)
    assert(!result::is_err(also_ok), "and is not an error")

    let err: Result<i64, i64> = Result::Err(2)
    assert(result::is_err(err), "Err is an error")
    let also_err: Result<i64, i64> = Result::Err(2)
    assert(!result::is_ok(also_err), "and is not ok")
}

// What `Err` carries is why there is no answer, and is not an answer: the
// fallback is what comes back, and never the 2 the error was carrying.
%test
fn unwrapping_a_result_gives_the_answer_or_the_fallback() {
    let ok: Result<i64, i64> = Result::Ok(1)
    assert_eq(&result::unwrap_or(ok, 9), &1, "Ok gives what is in it")
    let err: Result<i64, i64> = Result::Err(2)
    assert_eq(&result::unwrap_or(err, 9), &9, "Err gives the fallback")
}

%test
fn unwrapping_an_ok_gives_the_answer() {
    let ok: Result<i64, i64> = Result::Ok(1)
    assert_eq(&result::unwrap(ok, "there is one"), &1, "Ok unwraps")
}

// ---- Range ------------------------------------------------------------------------

// The length is counted here the way the `for` lowering counts it, which is why
// the file writes it out rather than leaving it to be assumed.
%test
fn a_range_is_as_long_as_the_turns_a_walk_over_it_has() {
    assert_eq(&range::len(Range { start: 0, end: 10 }), &10, "0..10")
    assert_eq(&range::len(Range { start: 5, end: 8 }), &3, "5..8")
    assert_eq(&range::len(Range { start: 4, end: 4 }), &0, "4..4 is empty")

    var turns = 0
    for i in 0..10 {
        turns = turns + 1
    }
    assert_eq(&turns, &10, "and a walk takes that many turns")
}

// Half open at the top, which is the whole of what there is to get wrong.
%test
fn a_range_holds_its_start_and_not_its_end() {
    // One each, a `Range` being no more `Copy` than an `Option` is.
    assert(range::holds(Range { start: 2, end: 5 }, 2), "the start is in it")
    assert(range::holds(Range { start: 2, end: 5 }, 4), "and so is the one below the end")
    assert(!range::holds(Range { start: 2, end: 5 }, 5), "the end is not")
    assert(!range::holds(Range { start: 2, end: 5 }, 1), "nor is anything below the start")
}

// ---- order ----------------------------------------------------------------------

// The hash sends neighbouring keys somewhere unrelated, which is the whole
// reason it is there: the tables probe forward, so an identity hash turns one
// into a linear scan.
%test
fn the_hash_does_not_leave_neighbours_as_neighbours() {
    var near = 0
    for i in 0..64 {
        let a = i
        let b = i + 1
        let apart = order::mix(&a) - order::mix(&b)
        if apart < 4 && apart > -4 {
            near = near + 1
        }
    }
    assert_eq(&near, &0, "no two neighbours hash near each other")

    let one = 1
    let also_one = 1
    assert_eq(&order::mix(&one), &order::mix(&also_one), "and one key hashes one way")
}

// The three traits, reached through a bound -- which is how a container asks
// for them. `Self` is what makes `Eq` and `Ord` writable at all: both take a
// second value of the type, and there was no way to say so before (section 2).

fn same_of<T: order::Eq>(a: &T, b: &T): bool { a.same(b) }
fn less_of<T: order::Ord>(a: &T, b: &T): bool { a.less(b) }
fn hash_of<T: order::Hash>(a: &T): i64 { a.hash() }

%test
fn a_bound_reaches_the_impl_written_for_the_key() {
    let a: i64 = 1
    let b: i64 = 2
    let also_one: i64 = 1
    assert(same_of(&a, &also_one), "two ones are equal")
    assert(!same_of(&a, &b), "and one and two are not")
    assert(less_of(&a, &b), "1 is less than 2")
    assert(!less_of(&b, &a), "and 2 is not less than 1")
    assert_eq(&hash_of(&a), &order::mix(&a), "an i64 hashes through `mix`")
}

// A string is the key the traits were wanted for as much as a number: it
// compares by what it says, and it hashes by what it says too.
%test
fn a_string_answers_the_three_as_a_number_does() {
    let a: str = "hello"
    let b: str = "hell"
    let c: str = "hello"
    assert(same_of(&a, &c), "the same characters")
    assert(!same_of(&a, &b), "and two that differ")
    assert(less_of(&b, &a), "a prefix comes first")
    assert_eq(&hash_of(&a), &hash_of(&c), "and one string hashes one way")
    assert(hash_of(&a) != hash_of(&b), "two others do not")
}

%test
fn a_bool_answers_them_too() {
    assert(same_of(&true, &true), "two trues")
    assert(!same_of(&true, &false), "and a true and a false")
    assert(less_of(&false, &true), "false comes first")
    assert(hash_of(&true) != hash_of(&false), "and they hash apart")
}

// ---- HashMap ----------------------------------------------------------------------

fn map_of(): HashMap<i64, i64> {
    hashmap::empty()
}

%test
fn a_map_gives_back_what_was_put_under_a_key() {
    var m = map_of()
    hashmap::insert(*m, 1, 10)
    hashmap::insert(*m, 2, 20)
    assert_eq(&hashmap::len(&m), &2, "two keys went in")
    assert(hashmap::has(&m, &1), "the first is there")
    assert(hashmap::has(&m, &2), "and so is the second")
    assert_eq(&hashmap::get_or(&m, &1, 0), &10, "under the first")
    assert_eq(&hashmap::get_or(&m, &2, 0), &20, "under the second")
}

%test
fn a_key_that_was_never_put_in_is_not_found() {
    var m = map_of()
    hashmap::insert(*m, 1, 10)
    assert(!hashmap::has(&m, &99), "99 was never put in")
    assert_eq(&hashmap::find(&m, &99), &-1, "and is nowhere")
    assert_eq(&hashmap::get_or(&m, &99, -7), &-7, "so the fallback comes back")
}

// The same key twice is one key: the second value replaces the first rather
// than standing beside it.
%test
fn putting_a_key_in_twice_replaces_what_was_under_it() {
    var m = map_of()
    hashmap::insert(*m, 1, 10)
    hashmap::insert(*m, 1, 11)
    assert_eq(&hashmap::len(&m), &1, "one key, put in twice")
    assert_eq(&hashmap::get_or(&m, &1, 0), &11, "and the later value")
}

%test
fn a_key_taken_out_is_gone_and_the_rest_are_not() {
    var m = map_of()
    hashmap::insert(*m, 1, 10)
    hashmap::insert(*m, 2, 20)
    assert(hashmap::remove(*m, &1), "taking one out says it was there")
    assert(!hashmap::remove(*m, &1), "and taking it out again says it was not")
    assert_eq(&hashmap::len(&m), &1, "one is left")
    assert(!hashmap::has(&m, &1), "and it is not the one taken out")
    assert_eq(&hashmap::get_or(&m, &2, 0), &20, "the other is untouched")
}

// A table grows rather than filling up, and what it must not lose while it does
// is a key. The removals in the middle are what leaves `GONE` places behind,
// which is the state a growing table has to walk through correctly.
%test
fn everything_survives_a_table_growing_many_times() {
    var m = map_of()
    for i in 0..300 {
        hashmap::insert(*m, i, i * 2)
    }
    for i in 0..300 {
        if i % 3 == 0 {
            hashmap::remove(*m, &i)
        }
    }
    var wrong = 0
    for i in 0..300 {
        let want_gone = i % 3 == 0
        if hashmap::has(&m, &i) == want_gone {
            wrong = wrong + 1
        }
        if !want_gone && hashmap::get_or(&m, &i, -1) != i * 2 {
            wrong = wrong + 1
        }
    }
    assert_eq(&wrong, &0, "every key is where it was left")
    assert_eq(&hashmap::len(&m), &200, "and the length is what was left in")
}

// ---- HashSet ------------------------------------------------------------------------

fn set_of(): HashSet<i64> {
    hashset::empty()
}

%test
fn a_set_holds_a_thing_once() {
    var s = set_of()
    assert(hashset::add(*s, 1), "the first time says it was new")
    assert(!hashset::add(*s, 1), "and the second says it was not")
    assert_eq(&hashset::len(&s), &1, "so there is one of it")
    assert(hashset::has(&s, &1), "and it is there")
    assert(!hashset::has(&s, &2), "and nothing else is")
}

%test
fn the_three_ways_of_putting_two_sets_together() {
    var a = set_of()
    var b = set_of()
    for i in 0..6 {
        hashset::add(*a, i)
    }
    for i in 3..9 {
        hashset::add(*b, i)
    }

    let both = hashset::union(&a, &b)
    assert_eq(&hashset::len(&both), &9, "0..9 between them")

    let shared = hashset::intersection(&a, &b)
    assert_eq(&hashset::len(&shared), &3, "3, 4 and 5 in both")
    assert(hashset::has(&shared, &3), "3 is in both")
    assert(!hashset::has(&shared, &2), "2 is only in the first")

    let mine = hashset::difference(&a, &b)
    assert_eq(&hashset::len(&mine), &3, "0, 1 and 2 in the first alone")
    assert(hashset::has(&mine, &0), "0 is the first's alone")
    assert(!hashset::has(&mine, &4), "4 is not")
}

// ---- TreeMap --------------------------------------------------------------------------

fn tree_of(): TreeMap<i64, i64> {
    treemap::empty()
}

%test
fn a_tree_map_gives_back_what_was_put_under_a_key() {
    var m = tree_of()
    treemap::insert(*m, 2, 20)
    treemap::insert(*m, 1, 10)
    assert_eq(&treemap::len(&m), &2, "two keys went in")
    assert(treemap::has(&m, &1), "the first is there")
    assert_eq(&treemap::get_or(&m, &2, 0), &20, "and the second's value")
    assert_eq(&treemap::find(&m, &99), &-1, "a key never put in is nowhere")
}

// The one thing a hashed map cannot answer: what the order is. The keys go in
// shuffled and come out sorted.
%test
fn a_tree_map_walks_its_keys_in_order() {
    var m = tree_of()
    let held = [5, 1, 9, 3, 7, 2, 8, 4, 6, 0]
    for i in 0..10 {
        treemap::insert(*m, held[i], held[i] * 10)
    }
    assert_eq(&treemap::len(&m), &10, "ten keys went in")

    assert_eq(&treemap::key_at(&m, treemap::first(&m)), &0, "the smallest is first")
    assert_eq(&treemap::key_at(&m, treemap::last(&m)), &9, "and the largest is last")

    var seen = 0
    var last_key = -1
    var out_of_order = 0
    var at = treemap::first(&m)
    while at >= 0 {
        let k = treemap::key_at(&m, at)
        if k <= last_key {
            out_of_order = out_of_order + 1
        }
        if treemap::val_at(&m, at) != k * 10 {
            out_of_order = out_of_order + 1
        }
        last_key = k
        seen = seen + 1
        at = treemap::next(&m, at)
    }
    assert_eq(&seen, &10, "the walk reaches every key")
    assert_eq(&out_of_order, &0, "and reaches them smallest first")
}

%test
fn a_tree_map_key_taken_out_is_gone_and_the_rest_are_not() {
    var m = tree_of()
    for i in 0..20 {
        treemap::insert(*m, i, i)
    }
    assert(treemap::remove(*m, &7), "taking one out says it was there")
    assert(!treemap::remove(*m, &7), "and again says it was not")
    assert_eq(&treemap::len(&m), &19, "nineteen are left")
    assert(!treemap::has(&m, &7), "and the one taken out is not among them")

    var seen = 0
    var at = treemap::first(&m)
    while at >= 0 {
        seen = seen + 1
        at = treemap::next(&m, at)
    }
    assert_eq(&seen, &19, "and the walk still reaches all of them")
}

// ---- TreeSet ----------------------------------------------------------------------------

fn tree_set_of(): TreeSet<i64> {
    treeset::empty()
}

%test
fn a_tree_set_holds_a_thing_once_and_in_order() {
    var s = tree_set_of()
    let held = [3, 1, 2, 1, 3]
    for i in 0..5 {
        treeset::add(*s, held[i])
    }
    assert_eq(&treeset::len(&s), &3, "three of the five were new")
    assert_eq(&treeset::elem_at(&s, treeset::first(&s)), &1, "the smallest is first")
    assert_eq(&treeset::elem_at(&s, treeset::last(&s)), &3, "and the largest is last")
    assert(treeset::has(&s, &2), "the middle one is there")
    assert(!treeset::has(&s, &9), "and one nobody added is not")
}

%test
fn a_tree_set_element_taken_out_is_gone() {
    var s = tree_set_of()
    for i in 0..10 {
        treeset::add(*s, i)
    }
    assert(treeset::remove(*s, &5), "taking one out says it was there")
    assert(!treeset::remove(*s, &5), "and again says it was not")
    assert_eq(&treeset::len(&s), &9, "nine are left")
    assert(!treeset::has(&s, &5), "and the one taken out is not among them")
}

// ---- What a literal builds -------------------------------------------------------------

// `#{1: 2}` is `var m = hashmap::empty(); hashmap::insert(*m, 1, 2); m`. That
// is what "a literal is syntax for a type a library declares" has to mean: the
// type is this library's, so the value has to be one this library made.
//
// It was a handle to a table inside the runtime, typed as the struct below --
// so `hashmap::len` on a map of three read uninitialised bytes and came back
// 136. It compiled, it linked, and every answer was garbage.

%test
fn a_map_literal_builds_the_library_type() {
    var m = #{1: 10, 2: 20, 3: 30}
    assert_eq(&hashmap::len(&m), &3, "three keys went in")
    assert_eq(&hashmap::get_or(&m, &2, 0), &20, "under the second")
    assert(!hashmap::has(&m, &9), "and one that was never put in is not there")
}

%test
fn a_set_literal_builds_one_too() {
    var s = #{1, 2, 2, 3}
    assert_eq(&hashset::len(&s), &3, "the repeat went in once")
    assert(hashset::has(&s, &2), "and it is there")
}

// The empty one is the shape worth proving: there are no entries to take the
// key type from, so it comes from what the literal is assigned to.
%test
fn an_empty_literal_is_a_map_with_nothing_in_it() {
    var m: HashMap<str, i64> = #{:}
    assert_eq(&hashmap::len(&m), &0, "nothing in it")
    hashmap::insert(*m, "a", 1)
    assert_eq(&hashmap::get_or(&m, &"a", 0), &1, "and then one thing")
}

%test
fn a_literal_takes_a_string_key() {
    var m = #{"one": 1, "two": 2}
    assert_eq(&hashmap::get_or(&m, &"two", 0), &2, "under a string")
}

// ---- A declaration written in a block ----------------------------------------------------

// "A `<const_decl>` is the compile-time constant, and stands there and in a
// block alike" (section 2), and a `<statement>` is a `<declaration>` -- so a
// struct, a fn, an enum and the rest all stand in a body too. Nothing declared
// them: the walk that makes declarations stopped at a fn's signature, so every
// one of them was written, lowered, and dropped on the floor.

%test
fn a_body_declares_what_is_written_in_it() {
    const N: i64 = 7
    struct P { pub x: i64 }
    fn twice(n: i64): i64 { n * 2 }
    let p = P { x: N }
    assert_eq(&twice(p.x), &14, "the const, the struct and the fn")
}

%test
fn one_nested_fn_reaches_another() {
    fn a(n: i64): i64 { b(n) + 1 }
    fn b(n: i64): i64 { n * 2 }
    assert_eq(&a(3), &7, "a calls b")
}

%test
fn a_nested_declaration_may_be_generic() {
    fn pair<T>(x: T, y: T): (T, T) { (x, y) }
    let (p, q) = pair(5, 6)
    assert_eq(&(p + q), &11, "both")
}

%test
fn an_enum_and_an_impl_stand_in_a_block() {
    enum E { A, B(i64) }
    struct Q { pub x: i64 }
    impl Q {
        fn twice(&self): i64 { self.x * 2 }
    }
    let held = E::B(4)
    let n = match held { E::A => 0, E::B(n) => n }
    let q = Q { x: n }
    assert_eq(&q.twice(), &8, "the impl was found")
}

// A block inside a block is the fn's too, which is where one written in the
// `else` of an `if` inside a `while` stands.
%test
fn a_declaration_in_a_nested_block_is_the_fns_as_well() {
    var t = 0
    if true {
        const K: i64 = 5
        t = K
    }
    assert_eq(&t, &5, "declared inside an `if`")
}

// ---- Running through one ---------------------------------------------------------------

// "The language has no iterator protocol, so what may be run through is a
// closed set" -- and the set is still closed, but a file joins it by writing
// three routines beside its declaration: `step`, `valid` and `elem`. The
// compiler writes the loop out of them, so what a turn hands over is `elem`'s
// answer and nothing below the checker has to know what a container is.
//
// Which is what lets a map be run through at all: it hands out a pair, and a
// `for` binds one with a tuple pattern (section 2).

%test
fn a_for_runs_through_a_map() {
    var m = #{1: 10, 2: 20, 3: 30}
    var t = 0
    for (k, v) in m { t = t + k * v }
    assert_eq(&t, &140, "every pair, once each")
}

%test
fn a_for_runs_through_a_set() {
    var s = #{1, 2, 3}
    var t = 0
    for x in s { t = t + x }
    assert_eq(&t, &6, "every element, once each")
}

// A tree yields in order, which is the whole of why one exists.
%test
fn a_tree_is_run_through_in_order() {
    var s: TreeSet<i64> = treeset::empty()
    treeset::add(*s, 5)
    treeset::add(*s, 1)
    treeset::add(*s, 3)
    var out = 0
    for x in s { out = out * 10 + x }
    assert_eq(&out, &135, "smallest first")
}

%test
fn a_tree_map_yields_its_pairs_in_order() {
    var m: TreeMap<i64, i64> = treemap::empty()
    treemap::insert(*m, 2, 20)
    treemap::insert(*m, 1, 10)
    var keys = 0
    var vals = 0
    for (k, v) in m {
        keys = keys * 10 + k
        vals = vals * 100 + v
    }
    assert_eq(&keys, &12, "the keys in order")
    assert_eq(&vals, &1020, "and their values with them")
}

%test
fn a_vector_is_run_through_in_the_order_it_was_filled() {
    var v: Vec<i64> = vec::empty()
    vec::push(*v, 1)
    vec::push(*v, 2)
    vec::push(*v, 3)
    var t = 0
    for x in v { t = t * 10 + x }
    assert_eq(&t, &123, "in the order they went in")
}

// A `break` carries a value out of one as it does out of any loop, and a
// `continue` takes the next turn -- which for a walk means stepping again.
%test
fn a_break_carries_a_value_out_of_a_walk() {
    var m = #{1: 10, 2: 20}
    let held = for (k, v) in m { if k == 2 { break v } }
    assert_eq(&held, &20, "the value under the key it stopped at")
}

%test
fn a_continue_takes_the_next_turn_of_a_walk() {
    var s = #{1, 2, 3, 4}
    var t = 0
    for x in s {
        if x == 2 { continue }
        t = t + x
    }
    assert_eq(&t, &8, "everything but the one it skipped")
}

%test
fn an_empty_container_yields_nothing() {
    var s: HashSet<i64> = #{,}
    var n = 0
    for x in s { n = n + 1 }
    assert_eq(&n, &0, "nothing to run through")
}

fn summed(m: &HashMap<i64, i64>): i64 {
    var t = 0
    for (k, v) in m { t = t + v }
    t
}

// "A reference stands for the place it refers to and is read... exactly as
// that place is" (section 3), and running through one is one of those reads.
%test
fn a_reference_to_a_container_is_run_through_too() {
    var m = #{1: 10, 2: 20}
    assert_eq(&summed(&m), &30, "through a reference")
}

// ---- A string as a key ---------------------------------------------------------------

// What the traits bought. A `str` answers `Eq`, `Ord` and `Hash`, so it is a
// key like a number is -- and it could not be one while the operations were
// function values, there being no pair written for it and no way to write one
// that the checker would hold a caller to.
//
// It is also the key that exercises a run of something two words wide, which
// is what `ptr str` is a run of. Indexing one used to read the pointer as if
// it were the pair, so a container of strings faulted before it had asked for
// any room.

%test
fn a_hashed_map_takes_a_string_key() {
    var m: HashMap<str, i64> = hashmap::empty()
    hashmap::insert(*m, "one", 1)
    hashmap::insert(*m, "two", 2)
    assert_eq(&hashmap::len(&m), &2, "two keys went in")
    assert_eq(&hashmap::get_or(&m, &"one", 0), &1, "under the first")
    assert_eq(&hashmap::get_or(&m, &"two", 0), &2, "under the second")
    assert(!hashmap::has(&m, &"three"), "and not one that was never put in")
}

%test
fn a_hashed_set_of_strings_holds_each_once() {
    var s: HashSet<str> = hashset::empty()
    assert(hashset::add(*s, "a"), "the first")
    assert(!hashset::add(*s, "a"), "and not the same one twice")
    assert_eq(&hashset::len(&s), &1, "one element")
}

%test
fn a_tree_map_takes_a_string_key() {
    var m: TreeMap<str, i64> = treemap::empty()
    treemap::insert(*m, "b", 2)
    treemap::insert(*m, "a", 1)
    assert_eq(&treemap::get_or(&m, &"a", 0), &1, "under the first")
    assert_eq(&treemap::get_or(&m, &"b", 0), &2, "under the second")
}

%test
fn a_tree_set_of_strings_is_in_order() {
    var s: TreeSet<str> = treeset::empty()
    treeset::add(*s, "pear")
    treeset::add(*s, "apple")
    treeset::add(*s, "fig")
    assert_eq(&treeset::len(&s), &3, "three went in")
    let at = treeset::first(&s)
    assert_eq(&treeset::elem_at(&s, at), &"apple", "the smallest comes first")
}

// ---- fmt ---------------------------------------------------------------------------------

// What `fmt` does with a format string is `runtime/src/fmt.rs`'s to test, and
// it does. What is left for this side is that an `Arg` carries the value it was
// handed -- the tag and the field agreeing -- which is what the comparisons
// below are reading.
%test
fn an_argument_carries_the_value_it_was_made_from() {
    assert_eq(&1, &1, "a number is itself")
    assert_eq(&"hi", &"hi", "and so is a string")
    assert_eq(&true, &true, "and so is a bool")
}
