// `Vec`: a run of values that grows.
//
// Section 3 says an owned array is fixed and "anything else is a library's to
// provide", and names this as the one the language assumes exists. It is the
// first thing here that manages its own room, and it is written the way the
// language gives for that: `ptr T` for where the values are, `p[i]` to reach
// one, and an `unsafe` around every line that does -- because what is at the
// far end of a pointer is exactly what the checker stopped answering for.
//
// The room comes from `mem.ft`, which is also where `stride` is and where both
// are explained: what the collector does and does not walk into, why nothing
// here frees, and why there is a `stride` to measure rather than a `size_of`
// to ask.
//
// The routines are free functions and not methods, for the reason `option.ft`
// gives -- which was that an `impl<T>` did not work. It does now, so what is
// left is that these have not been moved into one, and moving them is a change
// to every caller rather than to this file.
//
// Each takes a reference and not a value. A vector is not a `Copy` type, so
// handing one over by value hands it away -- a routine that read a length
// would have taken the vector to do it. Which reference is which is the usual
// rule: `&` to read, `*` to write, and `push` is the only one that writes the
// vector itself rather than what it points at.
//
// There is no auto-reference, so a caller writes the `&` or the `*`:
//
//     var v: Vec<i32> = empty()
//     push(*v, 1)
//     let one = at(&v, 0)

import mem::{room, stride};
import panic::panic;

pub struct Vec<T> {
    // Where the values are. Nothing outside this file reads it: it is `pub`
    // because the language has no other visibility that lets the routines
    // below reach it, and not because anybody else should.
    pub at:  ptr T,
    pub len: i64,
    pub cap: i64,
}

// ---- Making one -------------------------------------------------------------

// One with no room at all, which asks the runtime for nothing until something
// is put in it. The `T` comes from what the caller is assigning to:
// `let v: Vec<i32> = empty()` fixes it, there being no way to write it at the
// call.
pub fn empty<T>(): Vec<T> {
    unsafe let none = 0 as ptr T
    Vec { at: none, len: 0, cap: 0 }
}

// ---- What is in one ---------------------------------------------------------

pub fn len<T>(v: &Vec<T>): i64 {
    v.len
}

pub fn is_empty<T>(v: &Vec<T>): bool {
    v.len == 0
}

// What is at a place, and the place has to be one.
//
// This file used to say that the index was "the one thing a caller can check
// and this cannot answer for, there being no way yet to stop a program that
// asked for what is not there". There is one now (`panic.ft`), so the check is
// here: reading past the end is a bug in the caller, and the two ways to
// answer a bug are to say so and to carry on with whatever was at that
// address. The first is worth a compare and a branch.
pub fn at<T>(v: &Vec<T>, i: i64): T {
    if i < 0 || i >= v.len {
        panic("a vector was read past its end")
    }
    unsafe let out = v.at[i]
    out
}

pub fn put<T>(v: &Vec<T>, i: i64, x: T) {
    if i < 0 || i >= v.len {
        panic("a vector was written past its end")
    }
    unsafe v.at[i] = x
}

// ---- Growing ----------------------------------------------------------------

// Room for `want` of them, and nothing if there is that much already. The
// doubling is what makes a run of `push`es cost a constant each on average
// rather than a copy each: every element moved is paid for by the ones that
// went in without moving since the last time.
//
// Four to begin with because a vector that grew 1, 2, 4 would ask the runtime
// three times for what most vectors want at once, and the size classes
// (`runtime::heap::classes`) round anything smaller up to the same span
// regardless.
pub fn grow<T>(v: *Vec<T>, want: i64) {
    if want <= v.cap {
        return
    }
    var cap = 4
    while cap < want {
        cap = cap * 2
    }
    unsafe let held = room(cap * stride(v.at))
    unsafe let base = held as ptr T
    // Element by element rather than by bytes: there is no `memcpy` here that
    // is not the runtime's, and a loop the optimiser can see is worth more
    // than a call it cannot.
    var i = 0
    while i < v.len {
        unsafe base[i] = v.at[i]
        i = i + 1
    }
    v.at = base
    v.cap = cap
}

// One more on the end.
pub fn push<T>(v: *Vec<T>, x: T) {
    grow(v, v.len + 1)
    unsafe v.at[v.len] = x
    v.len = v.len + 1
}

// And one fewer. What it hands back is a copy of the last element; the room
// stays, because giving it up is the collector's decision and not this one's.
pub fn pop<T>(v: *Vec<T>): T {
    unsafe let out = v.at[v.len - 1]
    v.len = v.len - 1
    out
}
