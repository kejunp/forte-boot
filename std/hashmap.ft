// `HashMap`: keys to values, in no order at all.
//
// Open addressing with linear probing, which is the design a language with no
// allocator of its own should reach for: one run of keys, one of values and
// one of what each place is doing, so a lookup is one hash and then a walk
// forward through memory the machine has already fetched. The alternative --
// a bucket per hash holding a chain -- is a pointer chase per step and a heap
// allocation per entry, and this file has neither to spare.
//
// The room is a `ptr` per run, reached with `p[i]`, as `vec.ft` reaches its
// elements and for the same reasons. `room` and `stride` are `mem.ft`'s, which
// is where what the collector does and does not walk into is set out.
//
// ---- What a key has to come with -------------------------------------------
//
// A map has to hash a key and it has to say whether two are the same, and
// neither is something the language can do for an arbitrary `K`. There are no
// traits reaching this far -- an `impl<T>` does not yet scope its own
// parameter -- and the built-in `==` over a struct compares where the two
// *are* rather than what they hold, which is a wrong answer that looks like an
// answer. So the two are handed in, once, when the map is made:
//
//     fn hash_i64(k: &i64): i64 { mix(k) }
//     fn eq_i64(a: &i64, b: &i64): bool { a == b }
//     var m: HashMap<i64, str> = empty(hash_i64, eq_i64)
//
// That is a requirement written down rather than a bound the checker enforces,
// and it is the honest shape today: a map that quietly used `==` would be
// right for the scalars and wrong for everything else, and wrong without
// saying so. `order.ft` holds the pair for the type most keys are.

import mem::{room, stride};
import order::{eq_i64, mix};

// What a place in the runs is doing. Three states and not two, because a
// removal cannot simply mark a place free: a key that probed *past* it on the
// way in would no longer be found. So a removed place is `GONE`, which a
// search walks through and an insert may fill.
const FREE: u8 = 0
const TAKEN: u8 = 1
const GONE: u8 = 2

pub struct HashMap<K, V> {
    pub keys:  ptr K,
    pub vals:  ptr V,
    pub state: ptr u8,
    pub hash:  fn(&K): i64,
    pub eq:    fn(&K, &K): bool,
    pub len:   i64,
    // Always a power of two, or zero for a map that has asked for nothing yet.
    // That is what lets the wrap be an `&` rather than a `%`, and a `%` is a
    // division, and a division is the one arithmetic instruction worth going
    // out of the way to avoid in the innermost loop of a lookup.
    pub cap:   i64,
    // How many places are `TAKEN` or `GONE`. A probe stops at a `FREE` place,
    // so a map that filled up with tombstones would probe the whole run on
    // every miss however few keys it held. This is what the growth is measured
    // against, and it is why a map that is churned rather than filled still
    // rehashes.
    pub used:  i64,
}

// ---- Making one -------------------------------------------------------------

// One with no room, which asks for nothing until something is put in it. The
// `K` and `V` come from what the caller is assigning to, there being no way to
// write them at the call.
pub fn empty<K, V>(hash: fn(&K): i64, eq: fn(&K, &K): bool): HashMap<K, V> {
    unsafe let no_k = 0 as ptr K
    unsafe let no_v = 0 as ptr V
    unsafe let no_s = 0 as ptr u8
    HashMap {
        keys:  no_k,
        vals:  no_v,
        state: no_s,
        hash:  hash,
        eq:    eq,
        len:   0,
        cap:   0,
        used:  0,
    }
}

pub fn len<K, V>(m: &HashMap<K, V>): i64 {
    m.len
}

pub fn is_empty<K, V>(m: &HashMap<K, V>): bool {
    m.len == 0
}

// ---- Finding ----------------------------------------------------------------

// Where the key is, or -1. The index is into the runs and stays valid until
// the next insert, which is the only thing that moves anything.
//
// The walk stops at a `FREE` place because that is where this key would have
// been put, so anything past it was put there by somebody else. It walks
// through `GONE` for the reason `GONE` exists at all.
pub fn find<K, V>(m: &HashMap<K, V>, k: &K): i64 {
    if m.cap == 0 {
        return -1
    }
    let mask = m.cap - 1
    let f = m.hash
    var at = f(k) & mask
    var steps = 0
    while steps < m.cap {
        unsafe let what = m.state[at]
        if what == FREE {
            return -1
        }
        if what == TAKEN {
            let same = m.eq
            unsafe let is = same(&m.keys[at], k)
            if is {
                return at
            }
        }
        at = (at + 1) & mask
        steps = steps + 1
    }
    -1
}

pub fn has<K, V>(m: &HashMap<K, V>, k: &K): bool {
    find(m, k) >= 0
}

// What is under a key, or the fallback. There is no `Option` to hand back:
// this file cannot reach `option.ft`, imports not yet carrying names across
// files, and an `Option` declared here would be a second type of that name.
pub fn get_or<K, V>(m: &HashMap<K, V>, k: &K, other: V): V {
    let at = find(m, k)
    if at < 0 {
        return other
    }
    unsafe let out = m.vals[at]
    out
}

// What is at a place a `find` gave back. Reaching a value without hashing the
// key a second time, which is what a caller that already looked wants.
pub fn key_at<K, V>(m: &HashMap<K, V>, at: i64): K {
    unsafe let out = m.keys[at]
    out
}

pub fn val_at<K, V>(m: &HashMap<K, V>, at: i64): V {
    unsafe let out = m.vals[at]
    out
}

// Whether a place holds anything, for walking the whole map: the places are
// not in any order and most of them are empty, so a walk is `0` to `cap` with
// this asked at each.
pub fn taken_at<K, V>(m: &HashMap<K, V>, at: i64): bool {
    unsafe let what = m.state[at]
    what == TAKEN
}

pub fn places<K, V>(m: &HashMap<K, V>): i64 {
    m.cap
}

// ---- Putting things in -------------------------------------------------------

// Room for `want` places, and nothing if there is that much already.
//
// The load factor is three quarters, which is where linear probing is still
// walking a couple of places on a miss rather than a couple of dozen. It is
// measured against `used` and not `len` -- see the field.
pub fn grow<K, V>(m: *HashMap<K, V>, want: i64) {
    if want * 4 <= m.cap * 3 {
        return
    }
    var cap = 8
    while cap * 3 < want * 4 {
        cap = cap * 2
    }
    unsafe let no_k = 0 as ptr K
    unsafe let no_v = 0 as ptr V
    unsafe let k_room = room(cap * stride(no_k))
    unsafe let v_room = room(cap * stride(no_v))
    unsafe let s_room = room(cap)
    unsafe let keys = k_room as ptr K
    unsafe let vals = v_room as ptr V
    let state = s_room
    var i = 0
    while i < cap {
        unsafe state[i] = FREE
        i = i + 1
    }

    // Everything that was in goes in again, because where a key belongs is a
    // function of the capacity and the capacity has changed. The tombstones do
    // not come with it, which is the other half of what growing is for.
    let old_keys = m.keys
    let old_vals = m.vals
    let old_state = m.state
    let old_cap = m.cap
    m.keys = keys
    m.vals = vals
    m.state = state
    m.cap = cap
    m.len = 0
    m.used = 0
    var j = 0
    while j < old_cap {
        unsafe let what = old_state[j]
        if what == TAKEN {
            unsafe place(m, old_keys[j], old_vals[j])
        }
        j = j + 1
    }
}

// Put one in, assuming there is room. Every insert goes through here, growing
// or not, so there is one piece of code that decides where a key lives.
//
// The first `GONE` place on the way is remembered and used if the key turns
// out not to be there: that is what keeps a map that is churned rather than
// filled from walking further every time.
pub fn place<K, V>(m: *HashMap<K, V>, k: K, v: V) {
    let mask = m.cap - 1
    let f = m.hash
    var at = f(&k) & mask
    var free = -1
    var steps = 0
    while steps < m.cap {
        unsafe let what = m.state[at]
        if what == FREE {
            if free < 0 {
                free = at
            }
            break
        }
        if what == GONE {
            if free < 0 {
                free = at
            }
        }
        if what == TAKEN {
            let same = m.eq
            unsafe let is = same(&m.keys[at], &k)
            if is {
                unsafe m.vals[at] = v
                return
            }
        }
        at = (at + 1) & mask
        steps = steps + 1
    }
    // Nowhere to put it, which means every place is `TAKEN` and none of them
    // held this key. `insert` grows first, so nothing reaches here by that
    // road; a caller that used `place` on a full map does.
    if free < 0 {
        return
    }
    unsafe let was = m.state[free]
    unsafe m.keys[free] = k
    unsafe m.vals[free] = v
    unsafe m.state[free] = TAKEN
    m.len = m.len + 1
    if was == FREE {
        m.used = m.used + 1
    }
}

// Put one in, making room first. This is the one to call.
pub fn insert<K, V>(m: *HashMap<K, V>, k: K, v: V) {
    grow(m, m.used + 1)
    place(m, k, v)
}

// Take one out. What is left behind is a `GONE` place and not a `FREE` one,
// so that a key which probed past it is still found.
pub fn remove<K, V>(m: *HashMap<K, V>, k: &K): bool {
    let at = find(m, k)
    if at < 0 {
        return false
    }
    unsafe m.state[at] = GONE
    m.len = m.len - 1
    true
}
