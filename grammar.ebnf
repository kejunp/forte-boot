(* ==========================================================================
   fortec grammar
   --------------------------------------------------------------------------
   ISO-style EBNF:

       =           definition          "..."   terminal
       ;           end of rule         '...'   terminal
       |           alternation         (...)   grouping
       [...]       optional            {...}   zero or more
       (* ... *)   comment

   This grammar describes the *token* stream, not the character stream. Two
   passes run before it:

     1. The preprocessor (src/prep/comments.rs) blanks comments to spaces,
        preserving line and column.
     2. The lexer (src/lex/lexer.rs) produces tokens and *inserts separators*
        at line breaks that end a statement or an entry: a ";" in a statement
        body, a "," in a struct, enum or match body, and nothing at all before
        a "}" (see section 7).

   A ";" or "," is written explicitly or synthesised at a newline; either way
   the parser sees the same token, and the grammar below does not distinguish
   them. Newlines are otherwise invisible.
   ========================================================================== *)


(* ==========================================================================
   1. Compilation unit
   ========================================================================== *)

program         = { item } , EOF ;

item            = import_decl
                | { attribute } , [ visibility ] , declaration ;

visibility      = "public" | "private" ;

declaration     = fn_decl
                | struct_decl
                | enum_decl
                | trait_decl
                | impl_decl
                | var_decl ;                (* file-scope constants/globals *)

(* Attributes are the only use the lexer has for "#". *)
attribute       = "#" , "[" , attr_item , { "," , attr_item } , "]" ;

attr_item       = IDENTIFIER , [ "(" , [ attr_arg , { "," , attr_arg } ] , ")" ] ;

attr_arg        = literal | IDENTIFIER | attr_item ;


(* ==========================================================================
   2. Declarations
   ========================================================================== *)

import_decl     = "import" , import_path , [ "as" , IDENTIFIER ] , ";" ;

import_path     = IDENTIFIER , { "." , IDENTIFIER } ;

fn_decl         = "fn" , IDENTIFIER , [ generic_params ] ,
                  "(" , [ param_list ] , ")" , [ ":" , type ] ,
                  ( block | ";" ) ;         (* ";" = signature only, in a trait *)

param_list      = param , { "," , param } , [ "," ] ;

param           = ( "this" | IDENTIFIER ) , [ ":" , type ] ;

struct_decl     = "struct" , IDENTIFIER , [ generic_params ] ,
                  "{" , [ field_decl , { "," , field_decl } , [ "," ] ] ,
                  "}" , [ ";" ] ;

field_decl      = { attribute } , [ visibility ] , IDENTIFIER , ":" , type ;

enum_decl       = "enum" , IDENTIFIER , [ generic_params ] ,
                  "{" , [ enum_variant , { "," , enum_variant } , [ "," ] ] ,
                  "}" , [ ";" ] ;

enum_variant    = { attribute } , IDENTIFIER ,
                  [ "(" , type , { "," , type } , ")" ] ,
                  [ "=" , expression ] ;     (* explicit discriminant *)

trait_decl      = "trait" , IDENTIFIER , [ generic_params ] ,
                  "{" , { trait_member } , "}" , [ ";" ] ;

trait_member    = { attribute } , fn_decl ;

impl_decl       = "impl" , type , [ "for" , type ] ,
                  "{" , { impl_member } , "}" , [ ";" ] ;

impl_member     = { attribute } , [ visibility ] , fn_decl ;

var_decl        = ( "let" | "var" ) , IDENTIFIER , [ ":" , type ] ,
                  [ "=" , expression ] , ";" ;

(* Entries are comma-separated, written or inserted, and the trailing comma is
   optional in both styles: the lexer inserts nothing before a "}", and a line
   that ends — or begins — with a written "," gets no insertion either. *)


(* ==========================================================================
   3. Types
   ========================================================================== *)

type            = base_type , { "[" , [ INT_LITERAL ] , "]" } ;   (* T[] , T[8] *)

base_type       = primitive_type
                | named_type ;

named_type      = IDENTIFIER , { "." , IDENTIFIER } , [ generic_args ] ;

primitive_type  = "i8"  | "i16" | "i32" | "i64"
                | "u8"  | "u16" | "u32" | "u64"
                | "f32" | "f64"
                | "bool" | "char" | "str" | "void" ;

generic_params  = "<" , generic_param , { "," , generic_param } , ">" ;

generic_param   = IDENTIFIER , [ ":" , type_bounds ] ;

type_bounds     = named_type , { "&&" , named_type } ;

generic_args    = "<" , type , { "," , type } , ">" ;

(* Note for implementers: the lexer only guesses at "<". It opens a generic
   context after an IDENTIFIER and abandons it on any token that cannot appear
   in a type argument list. The parser must therefore still be able to reject
   a "<" that turned out to be a comparison. Inside an open context ">>" is
   emitted as two ">" tokens, so "Map<str, List<i32>>" closes cleanly. *)


(* ==========================================================================
   4. Statements
   ========================================================================== *)

(* Nothing is inserted before a "}", so the ";" ending the last statement of a
   block may be omitted — as it may anywhere the writer leaves it out and no
   newline follows. Read every ";" below as "; or the following }". *)
block           = "{" , { statement } , "}" ;

statement       = var_decl
                | if_stmt
                | while_stmt
                | for_stmt
                | match_stmt
                | return_stmt
                | break_stmt
                | continue_stmt
                | block , [ ";" ]
                | declaration                (* nested fn / struct / ... *)
                | expr_stmt
                | ";" ;                      (* empty statement *)

expr_stmt       = expression , ";" ;

if_stmt         = "if" , expression , block ,
                  { "elif" , expression , block } ,
                  [ "else" , block ] , [ ";" ] ;

while_stmt      = "while" , expression , block , [ ";" ] ;

for_stmt        = "for" , IDENTIFIER , "in" , expression , block , [ ";" ] ;

return_stmt     = "return" , [ expression ] , ";" ;

break_stmt      = "break" , ";" ;

continue_stmt   = "continue" , ";" ;

match_stmt      = "match" , expression ,
                  "{" , [ match_arm , { "," , match_arm } , [ "," ] ] ,
                  "}" , [ ";" ] ;

match_arm       = pattern , { "|" , pattern } , "=>" , ( expression | block ) ;

pattern         = "_"                                       (* wildcard *)
                | literal_pattern
                | range_pattern
                | variant_pattern
                | IDENTIFIER ;                               (* binding *)

literal_pattern = [ "-" ] , literal ;

range_pattern   = literal_pattern , ( ".." | "..=" ) , literal_pattern ;

variant_pattern = named_type , [ "(" , [ pattern , { "," , pattern } ] , ")" ] ;


(* ==========================================================================
   5. Expressions

   Lowest precedence first; each level is left-associative unless noted.
   ========================================================================== *)

expression      = assignment ;

(* Right-associative; the left side must be a place expression (name, field
   access or index) — a restriction the parser enforces, not the grammar. *)
assignment      = range_expr , [ assign_op , assignment ] ;

assign_op       = "=" | "+=" | "-=" | "*=" | "/="
                | "&=" | "|=" | "<<=" | ">>=" ;

(* Non-associative, and every bound is optional: "1..10", "1..", "..10",
   "..=n", "..". *)
range_expr      = logical_or , [ range_op , [ logical_or ] ]
                | range_op , [ logical_or ] ;

range_op        = ".." | "..=" ;

logical_or      = logical_and , { "||" , logical_and } ;

logical_and     = equality , { "&&" , equality } ;

equality        = comparison , { ( "==" | "!=" ) , comparison } ;

comparison      = shift , { ( "<" | ">" | "<=" | ">=" ) , shift } ;

shift           = additive , { ( "<<" | ">>" ) , additive } ;

additive        = multiplicative , { ( "+" | "-" ) , multiplicative } ;

multiplicative  = cast , { ( "*" | "/" | "%" ) , cast } ;

cast            = unary , { "as" , type } ;

unary           = ( "!" | "-" ) , unary
                | postfix ;

postfix         = primary , { postfix_op } ;

postfix_op      = "." , IDENTIFIER                           (* field / method *)
                | "(" , [ arg_list ] , ")"                   (* call *)
                | "[" , index , "]" ;                        (* index / slice *)

index           = expression ;                               (* a range is an expression *)

arg_list        = expression , { "," , expression } , [ "," ] ;

primary         = literal
                | "this"
                | path
                | struct_literal
                | array_literal
                | grouping ;

grouping        = "(" , expression , ")" ;

path            = IDENTIFIER , [ generic_args ] , { "." , IDENTIFIER } ;

struct_literal  = named_type , "{" , [ field_init , { "," , field_init } ,
                                       [ "," ] ] , "}" ;

field_init      = IDENTIFIER , ":" , expression ;

array_literal   = "[" , [ expression , { "," , expression } , [ "," ] ] , "]" ;

literal         = INT_LITERAL
                | FLOAT_LITERAL
                | STRING_LITERAL
                | CHAR_LITERAL
                | "true" | "false" | "null" ;


(* ==========================================================================
   6. Lexical grammar

   Produced by src/lex/lexer.rs. Listed for reference — the parser sees only
   the token kinds.
   ========================================================================== *)

IDENTIFIER      = ident_start , { ident_continue } ;         (* minus keywords *)
ident_start     = letter | "_" ;
ident_continue  = letter | digit | "_" ;

INT_LITERAL     = decimal_int | prefixed_int ;
decimal_int     = digit , { digit } ;                        (* fits in i64 *)
prefixed_int    = "0" , base_marker , base_digit , { base_digit } ;
base_marker     = "x" | "X"                                  (* base 16 *)
                | "o" | "O"                                  (* base  8 *)
                | "t" | "T"                                  (* base  3 *)
                | "b" | "B"                                  (* base  2 *)
                | "d" | "D" ;                                (* base 10 *)

(* A digit valid in the marker's base. *)
base_digit      = digit | letter ;

(* The fractional part is only taken when a digit follows the ".", so "1.foo"
   is INT_LITERAL "." IDENTIFIER and "1..2" is a range. *)
FLOAT_LITERAL   = digit , { digit } , "." , digit , { digit } ;

STRING_LITERAL  = '"' , { string_char | escape } , '"'
                | "`" , { raw_char } , "`" ;                 (* raw: no escapes *)

CHAR_LITERAL    = "'" , ( char_char | escape ) , "'" ;       (* exactly one *)

escape          = "\" , ( "n" | "t" | "r" | "0" | "\" | '"' | "'" | "`"
                        | "a" | "b" | "f" | "v" )
                | "\x" , hex_digit , hex_digit
                | "\u{" , hex_digit , { hex_digit } , "}" ;

string_char     = ? any character except '"' and '\' ? ;
raw_char        = ? any character except '`' ? ;
char_char       = ? any character except "'" and '\' ? ;
letter          = ? any alphabetic Unicode character ? ;
digit           = "0".."9" ;
hex_digit       = digit | "a".."f" | "A".."F" ;

keyword         = primitive_type
                | "fn" | "let" | "var" | "struct" | "trait" | "impl"
                | "public" | "private" | "import" | "enum"
                | "if" | "elif" | "else" | "while" | "for" | "in"
                | "return" | "break" | "continue" | "match"
                | "as" | "true" | "false" | "this" | "null" ;

comment         = "//" , { ? any character except newline ? }
                | "/*" , { ? any character ? } , "*/" ;      (* not nested *)


(* ==========================================================================
   7. Automatic separator insertion

   Separators may always be written by hand. The lexer inserts one at a
   newline when all of the following hold:

     a. The previous token can end a statement or entry: an identifier, a
        literal, "this", "null", "return", "break", "continue", ")", "]", "}",
        "..", a primitive type name, or the ">" closing a generic argument
        list.
     b. No "(" or "[" is open. Braces do not suppress insertion, so a block is
        a boundary but an argument list is not.
     c. The next line does not begin with "}". A closing brace ends the last
        entry or statement on its own, which is what makes the trailing comma
        of a struct, enum or match body optional, and the semicolon of a
        block's last statement optional with it.
     d. The next line does not begin with a continuation: one of
        . + - * / % = < > & | , :
        or one of the keywords  else  elif  as  in.
     e. A "->" does not precede the newline. "->" explicitly splices the next
        line onto this one and is consumed by the lexer, never reaching the
        parser.

   Which token is inserted depends on the innermost open brace:

     - a "," inside a *comma body* — the "{" opened by a "struct", "enum" or
       "match" header, whose entries are comma-separated;
     - a ";" anywhere else, including at top level and in the statement body
       of a fn, trait, impl, block or match arm.

   The two nest, so the "}" of an arm's block is followed by the "," that ends
   the arm, while a statement inside that block is followed by a ";".

   A separator is also inserted at end of input when (a) holds. "..=" never
   ends a statement — it always needs an upper bound — while ".." does.

   Caveat: a struct literal's "{" is not a comma body. The lexer cannot tell
   "Point {" from "if cond {", so it assumes the latter. Written commas make
   this invisible; omitting them inside a multi-line struct literal yields
   ";" between the fields.
   ========================================================================== *)


(* ==========================================================================
   8. Open questions

   These productions are extrapolated from the token set; the lexer does not
   pin them down, and no parser exists yet to confirm them.

     - import_decl: dotted path with an optional "as" alias is assumed. A
       string-literal path ("import \"std/io\"") would lex just as well.
     - attribute: "#" has no other plausible use, but "#[...]" versus a bare
       "#name" line is a free choice.
     - struct_literal: "Name { field: expr }" is ambiguous with a block after
       an expression, e.g. in "if x { ... }". Most languages resolve this by
       banning struct literals in condition position; that restriction is not
       expressed here.
     - type_bounds uses "&&" for multiple bounds because a single "&" is a
       lex error. "+" is the other candidate.
     - match_arm alternation uses "|", which is likewise a lex error on its
       own; "||" would be the token-legal spelling.
     - Array types ("T[]") and array literals are inferred from the lexer's
       comment about "<Map<str, i32[]>>"; sized arrays ("T[8]") are a guess.
     - No syntax is reserved for pointers/references, closures, or generic
       constraints beyond a bound list.
   ========================================================================== *)
